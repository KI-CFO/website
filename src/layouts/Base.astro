---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Consent from '../components/Consent.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://ki-buechhaltig.ch/#website',
      url: 'https://ki-buechhaltig.ch/',
      name: 'KI-CFO',
      description:
        'Arbeitsjournal über KI-Automatisierung in Buchhaltung und Finanzführung für Schweizer KMU.',
      inLanguage: 'de-CH',
      publisher: { '@id': 'https://ki-buechhaltig.ch/#florian' },
    },
    {
      '@type': 'Person',
      '@id': 'https://ki-buechhaltig.ch/#florian',
      name: 'Florian Lussi',
      url: 'https://ki-buechhaltig.ch/#ueber',
      image: 'https://ki-buechhaltig.ch/florian-lussi.jpg',
      email: 'mailto:florian@lussis.ch',
      sameAs: ['https://www.linkedin.com/in/flolussi/'],
      address: { '@type': 'PostalAddress', addressCountry: 'CH' },
      knowsAbout: [
        'Künstliche Intelligenz in der Buchhaltung',
        'Automatisierung von Finanzprozessen',
        'Bexio',
        'HubSpot',
        'n8n',
        'Liquiditätsplanung',
        'Monatsreporting',
      ],
    },
  ],
};
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="KI-CFO" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:image" content="https://ki-buechhaltig.ch/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://ki-buechhaltig.ch/og.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="KI-CFO · Projekte" href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="wordmark"><span class="dot"></span>KI-CFO</a>
        <nav class="site-nav">
          <a href="/projekte">Projekte</a>
          <a href="/#ueber">Über</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© 2026 KI-CFO · Florian Lussi</span>
        <nav>
          <a href="https://www.linkedin.com/in/flolussi/" rel="me noopener" target="_blank">LinkedIn</a>
          <a href="mailto:florian@lussis.ch">Kontakt</a>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
          <a href="#" id="cookie-settings-link">Cookie-Einstellungen</a>
        </nav>
      </div>
    </footer>

    <Consent />
  </body>
</html>
