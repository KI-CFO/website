---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('projekte', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = new Intl.DateTimeFormat('de-CH', { year: 'numeric', month: 'long', day: 'numeric' });

// Web3Forms access key. Solange der Platzhalter drin ist, wird die Umfrage nicht angezeigt.
const W3F_KEY = 'REPLACE_WITH_WEB3FORMS_KEY';
const surveyActive = W3F_KEY !== 'REPLACE_WITH_WEB3FORMS_KEY';
---
<Base
  title="KI-CFO · KI in Buchhaltung und Finanzführung, dokumentiert"
  description="Weniger Handarbeit in der Buchhaltung. Mehr Zeit für das, was Zahlen bedeuten. Ein Arbeitsjournal über KI-Automatisierung in Buchhaltung und Finanzführung für Schweizer KMU."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">KI in Buchhaltung &amp; Finanzführung · Schweiz</p>
      <h1>Weniger Handarbeit in der Buchhaltung. Mehr Zeit für das, was Zahlen bedeuten.</h1>
      <p class="sub">
        Ich baue KI-gestützte Automatisierungen für Buchhaltung und Finanzführung in
        Schweizer KMU. Hier dokumentiere ich Projekt für Projekt, was funktioniert
        und was nicht. Kein Produkt, kein Pitch. Ein Arbeitsjournal.
      </p>
      <a class="btn" href="/projekte">Projekte ansehen</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="section-label">Drei Leitsätze</p>
      <div class="cards">
        <div class="card">
          <h3>Kontrolle statt Blackbox</h3>
          <p>Die KI schlägt vor, du gibst frei. Jede Buchung, jede Rechnung, jede Zahl
          bleibt nachvollziehbar. Nichts verlässt das Haus ohne deinen Blick darauf.</p>
        </div>
        <div class="card">
          <h3>Keine zusätzliche Stelle</h3>
          <p>Das Repetitive übernimmt das System: erfassen, zuordnen, aufbereiten,
          erinnern. Deine Zeit gehört den Entscheidungen, nicht der Erfassung.</p>
        </div>
        <div class="card">
          <h3>Rechtzeitig auf dem Tisch</h3>
          <p>Der eigentliche Gewinn ist nicht Geschwindigkeit, sondern Timing:
          Abweichungen, offene Posten und Liquiditätsengpässe melden sich, bevor
          sie teuer werden.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="section-label">Anwendungsfälle</p>
      <div class="cases">
        <div class="card">
          <span class="tag">Buchhaltung</span>
          <h3>Kreditoren</h3>
          <p>Belege werden automatisch erfasst, zugeordnet und dir zur Freigabe
          vorgelegt statt abgetippt.</p>
        </div>
        <div class="card">
          <span class="tag">Buchhaltung</span>
          <h3>Debitoren</h3>
          <p>Vom gewonnenen Auftrag zur Rechnung: Zahlungspläne, Teilrechnungen und
          Meilensteine automatisch geplant, von dir freigegeben.</p>
        </div>
        <div class="card">
          <span class="tag">Buchhaltung</span>
          <h3>Mahnwesen</h3>
          <p>Freundlich, pünktlich, vorbereitet: Kein offener Posten geht mehr
          vergessen.</p>
        </div>
        <div class="card">
          <span class="tag">CFO</span>
          <h3>Monatsreporting</h3>
          <p>Die Zahlen sind aufbereitet, bevor jemand danach fragt: aus Bexio &amp; Co.,
          ohne Copy-Paste.</p>
        </div>
        <div class="card">
          <span class="tag">CFO</span>
          <h3>Liquidität</h3>
          <p>Ein rollierender Forecast aus echten Daten statt einer Excel-Datei, die
          niemand nachführt.</p>
        </div>
        <div class="card">
          <span class="tag">CFO</span>
          <h3>Frühwarnung</h3>
          <p>Ausreisser und Abweichungen werden automatisch markiert und landen
          rechtzeitig bei der richtigen Person.</p>
        </div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <p class="section-label">Aktuelle Projekte</p>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <span class="date">{fmt.format(post.data.pubDate)}</span>
              <h3><a href={`/projekte/${post.id}`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              {post.data.tools.length > 0 && (
                <div class="tools">{post.data.tools.map((t) => <span>{t}</span>)}</div>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {surveyActive && (
    <section class="section" id="umfrage">
      <div class="wrap">
        <p class="section-label">Kurze Umfrage</p>
        <h2>Wo stehst du mit KI?</h2>
        <p class="muted" style="max-width: 40rem;">Zwei Fragen, zehn Sekunden, anonym. Die Antworten helfen mir zu entscheiden, welche Projekte ich als Nächstes dokumentiere.</p>
        <form id="ki-umfrage" data-key={W3F_KEY}>
          <fieldset class="survey-group">
            <legend>Bist du als CFO oder Buchhalter:in tätig?</legend>
            <div class="survey-options">
              <label class="pill"><input type="radio" name="rolle" value="CFO" required /> CFO</label>
              <label class="pill"><input type="radio" name="rolle" value="Buchhalter:in" /> Buchhalter:in</label>
              <label class="pill"><input type="radio" name="rolle" value="Treuhand" /> Treuhand</label>
              <label class="pill"><input type="radio" name="rolle" value="Etwas anderes" /> Etwas anderes</label>
            </div>
          </fieldset>
          <fieldset class="survey-group">
            <legend>Wo nutzt du KI bereits? (Mehrfachauswahl)</legend>
            <div class="survey-options">
              <label class="pill"><input type="checkbox" name="ki_einsatz" value="Belegerfassung / Kreditoren" /> Belegerfassung / Kreditoren</label>
              <label class="pill"><input type="checkbox" name="ki_einsatz" value="Rechnungsstellung / Debitoren" /> Rechnungsstellung / Debitoren</label>
              <label class="pill"><input type="checkbox" name="ki_einsatz" value="Mahnwesen" /> Mahnwesen</label>
              <label class="pill"><input type="checkbox" name="ki_einsatz" value="Reporting / Abschluss" /> Reporting / Abschluss</label>
              <label class="pill"><input type="checkbox" name="ki_einsatz" value="Liquiditätsplanung" /> Liquiditätsplanung</label>
              <label class="pill"><input type="checkbox" name="ki_einsatz" value="Texte / E-Mails" /> Texte / E-Mails</label>
              <label class="pill"><input type="checkbox" name="ki_einsatz" value="Noch gar nicht" /> Noch gar nicht</label>
            </div>
          </fieldset>
          <input type="checkbox" name="botcheck" class="hidden-field" tabindex="-1" autocomplete="off" />
          <button type="submit" class="btn">Absenden</button>
          <p class="survey-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  )}

  <section class="section" id="ueber">
    <div class="wrap">
      <p class="section-label">Über</p>
      <div style="max-width: 40rem;">
        <p>
          Hinter dieser Seite steht Florian Lussi. Ich baue seit Jahren Systeme für
          Vertrieb und Geschäftsprozesse in Schweizer KMU und wende dieselben
          Prinzipien jetzt auf Buchhaltung und Finanzführung an: klare Datenmodelle,
          deterministische Abläufe, KI dort, wo sie stark ist, und ein Mensch überall
          dort, wo es um Geld geht.
        </p>
        <p>
          Zu kaufen gibt es hier nichts, zu lesen einiges: echte Projekte, echte
          Werkzeuge (Bexio, HubSpot, n8n, Claude), echte Stolpersteine. Wenn du an
          ähnlichen Fragen arbeitest, freue ich mich auf den Austausch:
          <a href="mailto:florian@lussis.ch">florian@lussis.ch</a> oder auf
          <a href="https://www.linkedin.com/in/flolussi/" rel="me noopener" target="_blank">LinkedIn</a>.
        </p>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('ki-umfrage') as HTMLFormElement | null;
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const status = form.querySelector('.survey-status') as HTMLElement;
        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        const data = new FormData(form);
        if (data.get('botcheck')) return;
        const auswahl = data.getAll('ki_einsatz').join(', ') || 'keine Angabe';
        btn.disabled = true;
        status.textContent = 'Wird gesendet …';
        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              access_key: form.dataset.key,
              subject: 'Neue Umfrage-Antwort auf ki-buechhaltig.ch',
              from_name: 'KI-CFO Umfrage',
              Rolle: data.get('rolle'),
              'KI-Einsatz': auswahl,
            }),
          });
          const json = await res.json();
          if (json.success) {
            form.innerHTML = '<p><strong>Danke!</strong> Deine Antwort ist angekommen.</p>';
          } else {
            throw new Error(json.message);
          }
        } catch {
          status.textContent = 'Senden hat nicht geklappt. Versuch es später nochmal oder schreib mir direkt: florian@lussis.ch';
          btn.disabled = false;
        }
      });
    }
  </script>
</Base>
