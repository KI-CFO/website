---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('projekte', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = new Intl.DateTimeFormat('de-CH', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base
  title="Projekte · KI-CFO"
  description="Alle dokumentierten Automatisierungs-Projekte aus Buchhaltung und Finanzführung: Ausgangslage, Lösung, Resultat, mit Werkzeugen und Stolpersteinen."
>
  <section class="article">
    <div class="wrap">
      <header>
        <h1>Projekte</h1>
        <p class="muted" style="max-width: 38rem;">
          Jedes Projekt dokumentiert nach demselben Muster: Ausgangslage → Lösung →
          Resultat. Mit den verwendeten Werkzeugen, und mit dem, was nicht
          funktioniert hat.
        </p>
      </header>
      {posts.length === 0 && (
        <p class="muted" style="margin-top: 2rem;">
          Die ersten Projekte sind in Arbeit und werden hier dokumentiert, sobald
          sie etwas zu zeigen haben.
        </p>
      )}
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <span class="date">{fmt.format(post.data.pubDate)}</span>
            <h3><a href={`/projekte/${post.id}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            {post.data.tools.length > 0 && (
              <div class="tools">{post.data.tools.map((t) => <span>{t}</span>)}</div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
